library identifier: 'hpc@main', retriever: modernSCM([
    $class: 'GitSCMSource', remote: 'https://github.com/thewillyP/hpc-deploy.git'])

hpcDeploy(
    image: 'haskell-devenv',

    variants: [
        cpu: [dockerUrl: 'docker://thewillyp/haskell-devenv', gpu: false],
    ],

    build: [time: '01:00:00', mem: '20G', cpus: 8],
    run:   [time: '06:00:00', mem: '14G', cpus: 4],

    fakeroot: true,
    binds:    '/home/wlp9800/dev:/root/dev,/home/wlp9800/.ssh:/root/.ssh',
    tsTag:    'tag:devenv',
    passEnv:  'AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_DEFAULT_REGION',

    runJob: '''
        ts_up "$TS_HOSTNAME" "$TS_TAG"
        sif_run "$SIF" /entrypoint.sh
    ''',
)